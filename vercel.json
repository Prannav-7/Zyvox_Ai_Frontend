{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "env": {
    "VITE_CLERK_PUBLISHABLE_KEY": "@vite_clerk_publishable_key",
    "VITE_API_URL": "@vite_api_url"
  },
  "buildEnv": {
    "VITE_CLERK_PUBLISHABLE_KEY": "@vite_clerk_publishable_key",
    "VITE_API_URL": "@vite_api_url"
  },
  "routes": [
    {
      "src": "^/.*",
      "dest": "/index.html",
      "status": 200
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        }
      ]
    }
  ]
}
